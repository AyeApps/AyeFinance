*.egg
MANIFEST
venv/
.venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# Node.js & Web App (Next.js 16 / React)
web/node_modules/
web/.next/
web/out/
web/build/
web/.npm
web/.turbo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
