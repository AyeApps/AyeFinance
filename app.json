{
  "expo": {
    "name": "AyeFinance",
    "slug": "ayefinance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "userInterfaceStyle": "dark",
    "scheme": "ayefinance",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ayeapps.ayefinance",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.ayeapps.ayefinance"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050505",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ayeapps.ayefinance",
      "versionCode": 1,
      "permissions": [],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "AyeFinance — Control de Gastos y Flujo de Caja",
      "shortName": "AyeFinance",
      "description": "Lleva el control de tus ingresos, gastos y cuentas bancarias en un solo lugar.",
      "themeColor": "#FE9D01",
      "backgroundColor": "#050505",
      "meta": {
        "viewport": "width=device-width, initial-scale=1, shrink-to-fit=no",
        "robots": "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
        "description": "Lleva el control de tus ingresos, gastos y cuentas bancarias en un solo lugar. Simple y pensado para el día a día.",
        "keywords": "control de flujo de caja, registro de ingresos y gastos, finanzas personales, gestión multicuentas, AyeFinance",
        "og:title": "AyeFinance — Control de Gastos y Flujo de Caja",
        "og:description": "Lleva el control de tus ingresos, gastos y cuentas bancarias en un solo lugar.",
        "og:url": "https://finance.ayeapps.com",
        "og:type": "website",
        "twitter:card": "summary_large_image",
        "twitter:title": "AyeFinance — Control de Gastos y Flujo de Caja",
        "twitter:description": "Lleva el control de tus ingresos, gastos y cuentas bancarias en un solo lugar."
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "./plugins/withAppleWidgets"
    ]
  }
}
