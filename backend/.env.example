# AyeFinance Environment Configuration
APP_NAME=AyeFinance
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database
MONGODB_URL=mongodb://localhost:27017/aye_finance_dev
DATABASE_NAME=aye_finance_dev
# Optional: MongoDB Atlas X.509 Certificate (Path or Base64 Encoded)
MONGODB_CERT_PATH=
MONGODB_CERT_B64=

# Security & Identity (Shared with aye-auth central microservice)
JWT_SECRET_KEY=super_secure_secret_key_minimum_32_characters_for_ayeapps_atelier
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:3002","https://finance.ayeapps.com"]

# Central Auth Endpoint
AYE_AUTH_URL=http://localhost:8000/api/v1/auth
